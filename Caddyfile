# Домен берётся из переменной APP_DOMAIN (см. .env / docker-compose.yml).
# Сертификат Let's Encrypt выпускается и продлевается автоматически.
{$APP_DOMAIN} {
	encode zstd gzip

	reverse_proxy node-app:3000 {
		# Приложение отвечает на /health — не отправляем трафик на неживой контейнер
		health_uri /health
		health_interval 30s
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}

	log {
		output stdout
		format console
	}
}

# ─── Сайты Тильды через этот сервер ─────────────────────────────────────────
#
# IP-адреса Тильды, на которых лежат страницы сайта, есть в реестре блокировок РКН
# (соседние сайты на том же адресе). Провайдеры, которые блокируют по IP, не пускают
# к ним покупателей. Адрес этого сервера чистый, поэтому страницы идут через него:
# DNS-запись поддомена указывает сюда, Caddy пересылает запрос Тильде с тем же именем сайта.
# Картинки, скрипты, формы и корзина Тильды лежат на других, не заблокированных адресах —
# браузер ходит к ним напрямую.
#
# Чтобы подключить поддомен: A-запись → IP этого сервера, блок ниже по образцу kzn.
# IP Тильды для поддомена: `dig +short <поддомен>` ДО смены DNS (сейчас kzn, smr, tlt, dmt —
# 185.215.4.45, fitbox.su — 176.57.65.237). Тильда сменит адрес — поменять здесь.

# {args[0]} — IP страниц Тильды, {args[1]} — имя сайта
(tilda_site) {
	reverse_proxy https://{args[0]} {
		header_up Host {args[1]}
		transport http {
			# Сертификат Тильды проверяется по имени сайта. Тильда продлевает его сама —
			# для этого блок http:// ниже пропускает к ней проверки Let's Encrypt
			tls_server_name {args[1]}
			dial_timeout 10s
		}
	}

	log {
		output stdout
		format console
	}
}

# Порт 80: проверки Let's Encrypt для сертификата Тильды пропускаем к Тильде
# (у неё общий сертификат на kzn, smr, tlt, dmt — сорвётся проверка kzn, не продлится и он).
# Свои проверки Caddy обрабатывает сам до этих правил. Остальное — на https.
(tilda_http) {
	handle /.well-known/acme-challenge/* {
		reverse_proxy http://{args[0]} {
			header_up Host {args[1]}
		}
	}
	handle {
		redir https://{host}{uri} 308
	}
}

kzn.fitbox.su {
	import tilda_site 185.215.4.45 kzn.fitbox.su
}

http://kzn.fitbox.su {
	import tilda_http 185.215.4.45 kzn.fitbox.su
}

dmt.fitbox.su {
	import tilda_site 185.215.4.45 dmt.fitbox.su
}

http://dmt.fitbox.su {
	import tilda_http 185.215.4.45 dmt.fitbox.su
}
